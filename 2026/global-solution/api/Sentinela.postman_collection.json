{
  "info": {
    "name": "Sentinela Cidadã",
    "description": "Após login copie o token retornado para a variável token da coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Cadastro de cidadão",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cadastro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cadastro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Pessoa Exemplo\",\n  \"email\": \"cidadao@example.test\",\n  \"senha\": \"SenhaSegura123\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.test\",\n  \"senha\": \"EscolhaUmaSenhaForte123\"\n}"
        }
      }
    },
    {
      "name": "Encerrar sessão",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logout"
          ]
        }
      }
    },
    {
      "name": "Listar locais",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/locais",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "locais"
          ]
        }
      }
    },
    {
      "name": "Listar sensores",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/sensores",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sensores"
          ]
        }
      }
    },
    {
      "name": "Listar leituras",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leituras",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "leituras"
          ]
        }
      }
    },
    {
      "name": "Listar alertas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/alertas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "alertas"
          ]
        }
      }
    },
    {
      "name": "Criar local",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/locais",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "locais"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Ponte Nova\",\n  \"bairro\": \"Centro\",\n  \"limiteNivel\": 2,\n  \"limiteChuva\": 30\n}"
        }
      }
    },
    {
      "name": "Atualizar local",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/locais/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "locais",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Córrego Esperança\",\n  \"bairro\": \"Vila Esperança\",\n  \"limiteNivel\": 2,\n  \"limiteChuva\": 30\n}"
        }
      }
    },
    {
      "name": "Excluir local sem sensores",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/locais/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "locais",
            "2"
          ]
        }
      }
    },
    {
      "name": "Enviar medição",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/leituras",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "leituras"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensorId\": 1,\n  \"valor\": 2.5\n}"
        }
      }
    }
  ]
}
